"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

msgid "1. Register the native host"
msgstr "1. 네이티브 호스트 등록"

msgid "2. Open extensions, enable Developer mode, then choose Load unpacked."
msgstr "2. 확장 프로그램을 열고 개발자 모드를 켠 다음 압축 해제된 확장 프로그램 로드를 선택하세요."

msgid "3. Select this folder. In the extension options, choose Check connection."
msgstr "3. 아래 폴더를 선택하고 확장 프로그램 옵션에서 연결 확인을 누르세요."

msgid "Active"
msgstr "진행 중"

msgid "Actual"
msgstr "실제"

msgid "Add"
msgstr "추가"

msgid "Add a link, or connect your browser to send downloads here."
msgstr "링크를 추가하거나 브라우저를 연결해 다운로드를 보내세요."

msgid "Add download"
msgstr "다운로드 추가"

msgid "All downloads"
msgstr "모든 다운로드"

msgid "Also delete the file from disk"
msgstr "디스크에서 파일도 삭제"

msgid "Always on top"
msgstr "항상 위에 표시"

msgid "Apply"
msgstr "적용"

msgid "Archives"
msgstr "압축 파일"

msgid "Browser"
msgstr "브라우저"

msgid "Browser extension"
msgstr "브라우저 확장"

msgid "Browser not found. Install it, then refresh."
msgstr "브라우저를 찾을 수 없습니다. 설치 후 새로고침하세요."

msgid "Browser setup actions apply immediately. Save only applies to app preferences."
msgstr "브라우저 설정 작업은 즉시 적용됩니다. 저장은 앱 환경설정에만 적용됩니다."

msgid "Browse…"
msgstr "찾아보기…"

msgid "Cancel"
msgstr "취소"

msgid "Categories"
msgstr "분류"

msgid "Checksum (MD5 / SHA-1 / SHA-256 / SHA-512, optional)"
msgstr "체크섬 (MD5 / SHA-1 / SHA-256 / SHA-512, 선택)"

msgid "Checksum must be 32, 40, 64 or 128 hex characters (prefix b2: for BLAKE2b)."
msgstr "체크섬은 32, 40, 64, 128자 16진수여야 합니다 (BLAKE2b는 b2: 접두사)."

msgid "Choose another category or return to all downloads."
msgstr "다른 분류를 선택하거나 모든 다운로드로 돌아가세요."

msgid "Chrome Web Store listing is not available yet. Install the bundled extension manually."
msgstr "아직 Chrome 웹 스토어에 등록되지 않았습니다. 함께 제공된 확장 프로그램을 수동으로 설치하세요."

msgid "Closing this window restores the main window."
msgstr "이 창을 닫으면 기본 창이 복원됩니다. 다운로드는 계속됩니다."

msgid "Compact window"
msgstr "간략 창"

msgid "Completed"
msgstr "완료"

msgid "Connect browser"
msgstr "브라우저 연결"

msgid "Connect your browser"
