msgid "1. Register the native host"
msgstr "1. 注册本机桥接程序"

msgid "2. Open extensions, enable Developer mode, then choose Load unpacked."
msgstr "2. 打开扩展程序，启用“开发者模式”，再选择“加载已解压的扩展程序”。"

msgid "3. Select this folder. In the extension options, choose Check connection."
msgstr "3. 选择下方文件夹，然后在扩展选项中点击“检查连接”。"

msgid "Active"
msgstr "进行中"

msgid "Actual"
msgstr "实际"

msgid "Add"
msgstr "新建"

msgid "Add a link, or connect your browser to send downloads here."
msgstr "添加链接，或连接浏览器，将下载发送到这里。"

msgid "Add download"
msgstr "新建下载"

msgid "All downloads"
msgstr "全部下载"

msgid "Also delete the file from disk"
msgstr "同时从磁盘删除文件"

msgid "Always on top"
msgstr "保持置顶"

msgid "Apply"
msgstr "应用"

msgid "Archives"
msgstr "压缩文件"

msgid "Browser"
msgstr "浏览器"

