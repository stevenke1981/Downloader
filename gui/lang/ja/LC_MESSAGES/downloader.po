"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

msgid "1. Register the native host"
msgstr "1. ネイティブホストを登録"

msgid "2. Open extensions, enable Developer mode, then choose Load unpacked."
msgstr "2. 拡張機能を開き、デベロッパーモードを有効にして「パッケージ化されていない拡張機能を読み込む」を選びます。"

msgid "3. Select this folder. In the extension options, choose Check connection."
msgstr "3. 下のフォルダーを選び、拡張機能のオプションで「接続を確認」を選びます。"

msgid "Active"
msgstr "アクティブ"

msgid "Actual"
msgstr "実際"

msgid "Add"
msgstr "追加"

msgid "Add a link, or connect your browser to send downloads here."
msgstr "リンクを追加するか、ブラウザーを連携してダウンロードを送信できます。"

msgid "Add download"
msgstr "ダウンロードを追加"

msgid "All downloads"
msgstr "すべて"

msgid "Also delete the file from disk"
msgstr "ディスクからファイルも削除する"

msgid "Always on top"
msgstr "常に手前に表示"

msgid "Apply"
msgstr "適用"

msgid "Archives"
msgstr "圧縮ファイル"

msgid "Browser"
msgstr "ブラウザー"

msgid "Browser extension"
msgstr "ブラウザー拡張機能"

msgid "Browser not found. Install it, then refresh."
msgstr "ブラウザーが見つかりません。インストール後に更新してください。"

msgid "Browser setup actions apply immediately. Save only applies to app preferences."
msgstr "ブラウザー設定の操作はすぐに反映されます。保存はアプリの設定にのみ適用されます。"

msgid "Browse…"
msgstr "参照…"

msgid "Cancel"
msgstr "キャンセル"

msgid "Categories"
msgstr "カテゴリ"

msgid "Checksum (MD5 / SHA-1 / SHA-256 / SHA-512, optional)"
msgstr "チェックサム（MD5 / SHA-1 / SHA-256 / SHA-512、任意）"

msgid "Checksum must be 32, 40, 64 or 128 hex characters (prefix b2: for BLAKE2b)."
msgstr "チェックサムは 32・40・64・128 文字の16進数で入力してください（BLAKE2b は b2: を付ける）。"

msgid "Choose another category or return to all downloads."
msgstr "別のカテゴリを選ぶか、すべてのダウンロードに戻ってください。"

msgid "Chrome Web Store listing is not available yet. Install the bundled extension manually."
msgstr "Chrome ウェブストアではまだ公開されていません。同梱の拡張機能を手動でインストールしてください。"

msgid "Closing this window restores the main window."
msgstr "このウィンドウを閉じるとメインウィンドウが復元されます。ダウンロードは続行されます。"

msgid "Compact window"
msgstr "コンパクトウィンドウ"

