msgstr "請選擇下載資料夾。"

msgid "Please enter a valid http(s) URL."
msgstr "請輸入有效的 http(s) 網址。"

msgid "Please enter valid numbers and times (HH:MM)."
msgstr "請輸入有效的數字和時間（HH:MM）。"

msgid "Priority"
msgstr "優先順序"

msgid "Programs"
msgstr "程式"

