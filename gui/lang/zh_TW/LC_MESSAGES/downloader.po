msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_TW\n"

msgid "1. Register the native host"
msgstr "1. 註冊本機橋接程式"

msgid "2. Open extensions, enable Developer mode, then choose Load unpacked."
msgstr "2. 開啟擴充功能，啟用「開發人員模式」，再選擇「載入未封裝項目」。"

msgid "3. Select this folder. In the extension options, choose Check connection."
msgstr "3. 選取下方資料夾，並在擴充功能選項中按「檢查連線」。"

msgid "Active"
msgstr "進行中"

msgid "Actual"
msgstr "實際"

msgid "Add"
msgstr "新增"

msgid "Add a link, or connect your browser to send downloads here."
msgstr "新增連結，或連接瀏覽器，將下載傳送到這裡。"

msgid "Add download"
msgstr "新增下載"

msgid "All downloads"
msgstr "全部下載"

msgid "Also delete the file from disk"
msgstr "同時從磁碟刪除檔案"

msgid "Always on top"
msgstr "保持置頂"

msgid "Apply"
msgstr "套用"

msgid "Archives"
msgstr "壓縮檔"

msgid "Browser"
msgstr "瀏覽器"

msgid "Browser extension"
msgstr "瀏覽器擴充功能"

msgid "Browser not found. Install it, then refresh."
msgstr "找不到瀏覽器。安裝後，請重新整理。"

msgid "Browser setup actions apply immediately. Save only applies to app preferences."
msgstr "瀏覽器設定操作會立即生效。「儲存」僅套用 App 偏好設定。"

msgid "Browse…"
msgstr "瀏覽…"

msgid "Cancel"
msgstr "取消"

msgid "Categories"
msgstr "分類"

msgid "Checksum (MD5 / SHA-1 / SHA-256 / SHA-512, optional)"
msgstr "校驗碼（MD5 / SHA-1 / SHA-256 / SHA-512，選填）"

msgid "Checksum must be 32, 40, 64 or 128 hex characters (prefix b2: for BLAKE2b)."
msgstr "校驗碼必須是 32、40、64 或 128 個十六進位字元（BLAKE2b 請加上 b2:）。"

msgid "Choose another category or return to all downloads."
msgstr "選擇其他分類，或返回全部下載。"

msgid "Chrome Web Store listing is not available yet. Install the bundled extension manually."
msgstr "目前尚未上架 Chrome 線上應用程式商店，請手動安裝隨附的擴充功能。"

msgid "Closing this window restores the main window."
msgstr "關閉精簡視窗會還原主視窗，下載繼續執行。"

msgid "Compact window"
msgstr "精簡視窗"

msgid "Completed"
msgstr "已完成"

msgid "Connect browser"
msgstr "連接瀏覽器"

msgid "Connect your browser"
msgstr "連接你的瀏覽器"

msgid "Connections"
msgstr "連線數"

msgid "Connections per download"
msgstr "每個下載的連線數"

msgid "Copy path"
msgstr "複製路徑"

msgid "Could not check browser setup:"
msgstr "無法檢查瀏覽器設定："

msgid "Could not copy the extension path:"
msgstr "無法複製擴充功能路徑："

msgid "Could not open the file location:"
msgstr "無法開啟檔案位置："

msgid "Could not open:"
msgstr "無法開啟："

msgid "Could not register the native host:"
msgstr "無法註冊本機橋接程式："

msgid "Ctrl+Tab switches sections · Esc cancels"
msgstr "Ctrl+Tab 切換分頁 · Esc 取消"

msgid "Default folder for the file type"
msgstr "依檔案類型的預設資料夾"

msgid "Default limit per download (KB/s)"
msgstr "每個下載的預設限速（KB/s）"

msgid "Delete"
msgstr "刪除"

msgid "Delete download"
msgstr "刪除下載"

msgid "Dismiss"
msgstr "關閉提示"

msgid "Documents"
msgstr "文件"

msgid "Double-click a completed download to locate its file."
msgstr "雙擊已完成的下載，即可開啟檔案所在資料夾。"

msgid "Download folder"
msgstr "下載資料夾"

msgid "Downloader — compact"
msgstr "Downloader — 精簡視窗"

msgid "Downloading"
msgstr "下載中"

msgid "Downloads"
msgstr "下載"

msgid "Downloads are still queued, running or verifying. Exit and pause them? You can resume them when Downloader opens again."
msgstr "仍有排程中、下載中或驗證中的項目。確定要退出並暫停嗎？下次開啟 Downloader 可繼續下載。"

msgid "Error"
msgstr "錯誤"

msgid "Exit"
msgstr "退出"

msgid "Exit Downloader?"
msgstr "要退出 Downloader 嗎？"

msgid "Expected"
msgstr "預期"

msgid "Extension folder"
msgstr "擴充功能資料夾"

msgid "Extension folder unavailable"
msgstr "找不到擴充功能資料夾"

msgid "Extension path copied."
msgstr "已複製擴充功能路徑。"

msgid "General"
msgstr "一般"

